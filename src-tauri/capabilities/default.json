{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Coursera DL main window",
  "windows": [
    "main",
    "*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:default",
    "fs:default",
    "opener:default",
    "process:default",
    "shell:default"
  ]
}
