# Dependencies
node_modules/

# Production build outputs
dist/
dist-ssr/
src-tauri/target/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb

# OS / Editor files
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# =========================================================================
# ⚙️ TAURI / RUST COMPILATION ARTIFACTS
# =========================================================================
# Blocks all compiled binaries, intermediate objects, and cache layers.
target/
src-tauri/target/

# =========================================================================
# 🌐 FRONTEND / NODE DEPENDENCIES
# =========================================================================
# Blocks raw package dependencies and standard lock storage environments.
node_modules/
.pnpm-store/
.yarn/
dist/
build/
.svelte-kit/
.next/
out/

# =========================================================================
# 🔒 LOCAL CREDENTIALS, LOGS & COOKIES
# =========================================================================
# Strictly blocks test cookies, environment keys, and running stack traces.
.env
.env.*
!.env.example
*.key
*.key.pub
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================================================
# 🖥️ DESKTOP OS SYSTEM CLUTTER
# =========================================================================
# Discards system index databases and directory-specific platform layout preferences.
.DS_Store
Thumbs.db
*.bak
*.swp

# =========================================================================
# 📁 LOCAL ARCHIVES & USER DOWNLOADS (Project Specific)
# =========================================================================
# Blocks local media directories created during testing cycles.
/downloads/
/output/
/test-courses/
*.mp4
*.pdf
